import React, { useState, useEffect } from 'react';
import { supabase } from '../lib/supabase';
import { validateMarks, calculateTaskSubtotal, calculateGrandTotal, calculatePercentage, determineCompetency } from '../lib/calculations';

export default function DigitalAssessment({ sessionId, assessmentId, onComplete }) {
  const [session, setSession] = useState(null);
  const [tasks, setTasks] = useState([]);
  const [checklists, setChecklists] = useState([]);
  const [results, setResults] = useState({});
  const [checklistResults, setChecklistResults] = useState({});
  const [feedback, setFeedback] = useState({ from_candidate: '', to_candidate: '' });
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState('');
  const [showReview, setShowReview] = useState(false);

  useEffect(() => {
    if (sessionId) {
      loadSession();
    }
  }, [sessionId]);

  const loadSession = async () => {
    // Load session
    const { data: sessionData, error: sessionError } = await supabase
      .from('assessment_sessions')
      .select('*, trainees(*), assessments(*)')
      .eq('id', sessionId)
      .single();

    if (sessionError) {
      setMessage('Error loading session: ' + sessionError.message);
      return;
    }
    setSession(sessionData);

    // Load tasks and items
    const { data: tasksData } = await supabase
      .from('assessment_tasks')
      .select('*, assessment_items(*)')
      .eq('assessment_id', assessmentId)
      .order('sort_order');

    if (tasksData) {
      setTasks(tasksData.sort((a, b) => a.sort_order - b.sort_order));
    }

    // Load checklists
    const { data: checklistsData } = await supabase
      .from('observation_checklists')
      .select('*, checklist_criteria(*)')
      .eq('assessment_id', assessmentId)
      .order('sort_order');

    if (checklistsData) {
      setChecklists(checklistsData.sort((a, b) => a.sort_order - b.sort_order));
    }

    // Load existing results
    const { data: resultsData } = await supabase
      .from('criterion_results')
      .select('*')
      .eq('session_id', sessionId);

    if (resultsData) {
      const resultsMap = {};
      resultsData.forEach(r => { resultsMap[r.item_id] = r; });
      setResults(resultsMap);
    }

    const { data: checklistResultsData } = await supabase
      .from('checklist_results')
      .select('*')
      .eq('session_id', sessionId);

    if (checklistResultsData) {
      const resultsMap = {};
      checklistResultsData.forEach(r => { resultsMap[r.criteria_id] = r; });
      setChecklistResults(resultsMap);
    }

    // Load feedback
    const { data: feedbackData } = await supabase
      .from('assessment_feedback')
      .select('*')
      .eq('session_id', sessionId)
      .single();

    if (feedbackData) {
      setFeedback({
        from_candidate: feedbackData.feedback_from_candidate || '',
        to_candidate: feedbackData.feedback_to_candidate || ''
      });
    }
  };

  const handleMarkChange = async (itemId, value, maxMarks) => {
    const validation = validateMarks(value, maxMarks);
    if (!validation.valid) {
      setMessage(validation.error);
      setTimeout(() => setMessage(''), 3000);
      return;
    }

    const newResults = { ...results };
    if (newResults[itemId]) {
      newResults[itemId] = { ...newResults[itemId], marks_obtained: validation.value };
    } else {
      newResults[itemId] = { item_id: itemId, marks_obtained: validation.value, comments: '' };
    }
    setResults(newResults);

    // Save to database
    await supabase.from('criterion_results').upsert({
      session_id: sessionId,
      item_id: itemId,
      marks_obtained: validation.value,
      updated_at: new Date().toISOString()
    }, { onConflict: 'session_id,item_id' });
  };

  const handleCommentChange = (itemId, value) => {
    const newResults = { ...results };
    if (newResults[itemId]) {
      newResults[itemId] = { ...newResults[itemId], comments: value };
    } else {
      newResults[itemId] = { item_id: itemId, marks_obtained: 0, comments: value };
    }
    setResults(newResults);
  };

  const handleChecklistMarkChange = async (criteriaId, value, maxMarks) => {
    const validation = validateMarks(value, maxMarks);
    if (!validation.valid) {
      setMessage(validation.error);
      setTimeout(() => setMessage(''), 3000);
      return;
    }

    const newResults = { ...checklistResults };
    if (newResults[criteriaId]) {
      newResults[criteriaId] = { ...newResults[criteriaId], marks_obtained: validation.value };
    } else {
      newResults[criteriaId] = { criteria_id: criteriaId, marks_obtained: validation.value, comments: '' };
    }
    setChecklistResults(newResults);

    await supabase.from('checklist_results').upsert({
      session_id: sessionId,
      criteria_id: criteriaId,
      marks_obtained: validation.value,
      updated_at: new Date().toISOString()
    }, { onConflict: 'session_id,criteria_id' });
  };

  const calculateTotals = () => {
    const taskSubtotals = tasks.map(task => {
      const items = task.assessment_items || [];
      let subtotal = 0;
      let maxSubtotal = 0;
      items.forEach(item => {
        if (!item.is_subcriterion) {
          maxSubtotal += parseFloat(item.max_marks) || 0;
          const r = results[item.id];
          subtotal += r ? (parseFloat(r.marks_obtained) || 0) : 0;
        }
      });
      return { taskNumber: task.task_number, subtotal, maxSubtotal };
    });

    let checklistSubtotal = 0;
    let checklistMax = 0;
    checklists.forEach(cl => {
      (cl.checklist_criteria || []).forEach(c => {
        if (!c.is_subitem) {
          checklistMax += parseFloat(c.max_marks) || 0;
          const r = checklistResults[c.id];
          checklistSubtotal += r ? (parseFloat(r.marks_obtained) || 0) : 0;
        }
      });
    });

    const grandTotalAvailable = taskSubtotals.reduce((s, t) => s + t.maxSubtotal, 0) + checklistMax;
    const grandTotalObtained = taskSubtotals.reduce((s, t) => s + t.subtotal, 0) + checklistSubtotal;
    const percentage = calculatePercentage(grandTotalObtained, grandTotalAvailable);
    const outcome = determineCompetency(percentage);

    return { taskSubtotals, checklistSubtotal, checklistMax, grandTotalAvailable, grandTotalObtained, percentage, outcome };
  };

  const saveProgress = async () => {
    setSaving(true);
    const totals = calculateTotals();

    await supabase.from('assessment_sessions').update({
      grand_total_available: totals.grandTotalAvailable,
      grand_total_obtained: totals.grandTotalObtained,
      percentage: totals.percentage,
      competency_outcome: totals.outcome,
      updated_at: new Date().toISOString()
    }).eq('id', sessionId);

    // Save feedback
    await supabase.from('assessment_feedback').upsert({
      session_id: sessionId,
      feedback_from_candidate: feedback.from_candidate,
      feedback_to_candidate: feedback.to_candidate,
      updated_at: new Date().toISOString()
    }, { onConflict: 'session_id' });

    setMessage('Progress saved successfully!');
    setSaving(false);
    setTimeout(() => setMessage(''), 3000);
  };

  const submitAssessment = async () => {
    if (!window.confirm('Are you sure you want to submit this assessment? It will be locked for editing.')) {
      return;
    }

    await saveProgress();

    await supabase.from('assessment_sessions').update({
      status: 'submitted',
      updated_at: new Date().toISOString()
    }).eq('id', sessionId);

    setMessage('Assessment submitted successfully!');
    onComplete?.();
  };

  const totals = calculateTotals();

  if (!session) {
    return <div className="text-center p-5">Loading assessment...</div>;
  }

  return (
    <div className="digital-assessment">
      <div className="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h3><i className="bi bi-clipboard-data"></i> Digital Assessment</h3>
          <p className="text-muted mb-0">
            {session.assessments?.title} - {session.trainees?.full_name} ({session.trainees?.admission_number})
          </p>
        </div>
        <div>
          <button className="btn btn-outline-primary me-2" onClick={saveProgress} disabled={saving}>
            <i className="bi bi-save"></i> {saving ? 'Saving...' : 'Save Progress'}
          </button>
          <button className="btn btn-warning me-2" onClick={() => setShowReview(!showReview)}>
            <i className="bi bi-eye"></i> {showReview ? 'Hide' : 'Show'} Review
          </button>
          <button className="btn btn-success" onClick={submitAssessment}
            disabled={session.status !== 'in_progress'}>
            <i className="bi bi-check-circle"></i> Submit Assessment
          </button>
        </div>
      </div>

      {message && (
        <div className={`alert ${message.includes('Error') ? 'alert-danger' : 'alert-success'} alert-dismissible fade show`}>
          {message}
          <button type="button" className="btn-close" onClick={() => setMessage('')}></button>
        </div>
      )}

      {/* Status Badge */}
      <div className="mb-3">
        <span className={`badge ${
          session.status === 'in_progress' ? 'bg-primary' :
          session.status === 'submitted' ? 'bg-warning' :
          session.status === 'verified' ? 'bg-success' : 'bg-secondary'
        }`}>
          Status: {session.status.replace('_', ' ').toUpperCase()}
        </span>
        {session.status !== 'in_progress' && (
          <span className="badge bg-danger ms-2">LOCKED</span>
        )}
      </div>

      {/* Observation Checklist */}
      {checklists.map((cl) => (
        <div key={cl.id} className="card mb-4">
          <div className="card-header bg-primary text-white">
            <h5 className="mb-0">{cl.title}</h5>
            {cl.instruction && <small>{cl.instruction}</small>}
          </div>
          <div className="card-body p-0">
            <table className="table table-bordered mb-0">
              <thead className="table-light">
                <tr>
                  <th style={{ width: '55%' }}>Item to be Evaluated</th>
                  <th style={{ width: '12%' }}>Marks Available</th>
                  <th style={{ width: '12%' }}>Marks Obtained</th>
                  <th style={{ width: '21%' }}>Comment</th>
                </tr>
              </thead>
              <tbody>
                {(cl.checklist_criteria || []).map((c) => (
                  <tr key={c.id} className={c.is_subitem ? 'table-secondary' : ''}>
                    <td className={c.is_subitem ? 'ps-4' : ''}>
                      {c.is_subitem && '• '}{c.item_number}. {c.description}
                    </td>
                    <td className="text-center">{c.max_marks}</td>
                    <td className="text-center">
                      {session.status === 'in_progress' ? (
                        <input type="number" className="form-control form-control-sm marks-input"
                          value={checklistResults[c.id]?.marks_obtained || 0}
                          onChange={(e) => handleChecklistMarkChange(c.id, e.target.value, c.max_marks)}
                          min="0" max={c.max_marks} step="0.5" />
                      ) : (
                        <span>{checklistResults[c.id]?.marks_obtained || 0}</span>
                      )}
                    </td>
                    <td>
                      {session.status === 'in_progress' ? (
                        <input type="text" className="form-control form-control-sm"
                          value={checklistResults[c.id]?.comments || ''}
                          onChange={(e) => {
                            const newResults = { ...checklistResults };
                            if (newResults[c.id]) {
                              newResults[c.id] = { ...newResults[c.id], comments: e.target.value };
                            } else {
                              newResults[c.id] = { criteria_id: c.id, marks_obtained: 0, comments: e.target.value };
                            }
                            setChecklistResults(newResults);
                          }} />
                      ) : (
                        <span>{checklistResults[c.id]?.comments || ''}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      {/* Tasks */}
      {tasks.map((task) => {
        const taskTotal = totals.taskSubtotals.find(t => t.taskNumber === task.task_number);
        return (
          <div key={task.id} className="card mb-4">
            <div className="card-header bg-dark text-white">
              <h5 className="mb-0">TASK {task.task_number} {task.task_title && `- ${task.task_title}`}</h5>
            </div>
            <div className="card-body p-0">
              <table className="table table-bordered mb-0">
                <thead className="table-light">
                  <tr>
                    <th style={{ width: '55%' }}>Criterion</th>
                    <th style={{ width: '12%' }}>Max Marks</th>
                    <th style={{ width: '12%' }}>Marks Obtained</th>
                    <th style={{ width: '21%' }}>Comment</th>
                  </tr>
                </thead>
                <tbody>
                  {(task.assessment_items || []).map((item) => (
                    <tr key={item.id} className={item.is_subcriterion ? 'table-secondary' : ''}>
                      <td className={item.is_subcriterion ? 'ps-4' : ''}>
                        {item.is_subcriterion && '• '}{item.item_number}. {item.description}
                        {item.instruction && <div><small className="text-muted fst-italic">({item.instruction})</small></div>}
                      </td>
                      <td className="text-center">{item.max_marks}</td>
                      <td className="text-center">
                        {session.status === 'in_progress' ? (
                          <input type="number" className="form-control form-control-sm marks-input"
                            value={results[item.id]?.marks_obtained || 0}
                            onChange={(e) => handleMarkChange(item.id, e.target.value, item.max_marks)}
                            min="0" max={item.max_marks} step="0.5" />
                        ) : (
                          <span>{results[item.id]?.marks_obtained || 0}</span>
                        )}
                      </td>
                      <td>
                        {session.status === 'in_progress' ? (
                          <input type="text" className="form-control form-control-sm"
                            value={results[item.id]?.comments || ''}
                            onChange={(e) => handleCommentChange(item.id, e.target.value)} />
                        ) : (
                          <span>{results[item.id]?.comments || ''}</span>
                        )}
                      </td>
                    </tr>
                  ))}
                  <tr className="table-warning">
                    <td className="text-end fw-bold">Sub-Total {task.task_number}</td>
                    <td className="text-center fw-bold">{taskTotal?.maxSubtotal || 0}</td>
                    <td className="text-center fw-bold">{taskTotal?.subtotal || 0}</td>
                    <td></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
